---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandBar from '../components/islands/CommandBar';
import { SITE } from '../config/site';
import { getFlags, commandProps, url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  active?: 'writing' | 'lab' | 'builds' | 'about' | null;
  home?: boolean;
  footer?: string;
  ogType?: 'website' | 'article';
}
const { title, description = SITE.description, active = null, home = false, footer, ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — learning computers in public`;
const flags = await getFlags();
const canonical = new URL(Astro.url.pathname, Astro.site);
const cmdProps = await commandProps();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — all posts`} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#2e0f55" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header active={active} home={home} flags={flags} />
    <main id="main">
      <slot />
    </main>
    <slot name="after" />
    <Footer label={footer} />
    {!home && <CommandBar client:idle mode="palette" {...cmdProps} />}
    <script type="application/json" id="flag-data" set:html={JSON.stringify(flags)} />
    <script>
      import { getFound, onFlags } from '../lib/flags';
      const paint = (ids: string[]) =>
        document.querySelectorAll<HTMLElement>('[data-flag]').forEach((el) => el.setAttribute('data-found', String(ids.includes(el.dataset.flag!))));
      paint(getFound());
      onFlags(paint);
    </script>
  </body>
</html>
