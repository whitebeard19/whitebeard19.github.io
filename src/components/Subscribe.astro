---
import { SITE } from '../config/site';
interface Props { title?: string }
const { title = 'Learn alongside me. One email when something new clicks.' } = Astro.props;
---
{!SITE.newsletterAction.includes('[') && (<section class="subscribe" aria-labelledby="sub-h">
  <div class="wrap subscribe__in">
    <h2 id="sub-h" class="h3">{title}</h2>
    <form action={SITE.newsletterAction} method="post" target="_blank">
      <label for="sub-email" class="label" style="font-size:13px">YOUR EMAIL</label>
      <div class="row">
        <input id="sub-email" type="email" name="email" required placeholder="you@domain.com" autocomplete="email" />
        <button type="submit" class="key key--dark" style="min-height:52px;border-width:3px;border-bottom-width:7px">SUBSCRIBE ↵</button>
      </div>
      <span style="font-size:14px">No spam. Unsubscribing is one click, and I won't take it personally.</span>
    </form>
  </div>
</section>)}
