---
import Base from '../layouts/Base.astro';
import CommandBar from '../components/islands/CommandBar';
import BootScreen from '../components/islands/BootScreen';
import ToyBench from '../components/islands/ToyBench';
import GitRow from '../components/GitRow.astro';
import Window from '../components/Window.astro';
import LayerLegend from '../components/LayerLegend.astro';
import BuildCard from '../components/BuildCard.astro';
import Subscribe from '../components/Subscribe.astro';
import Empty from '../components/Empty.astro';
import { SITE, NOW } from '../config/site';
import { LAYERS, LAYER_KEYS, TOPICS, topicsOf } from '../config/taxonomy';
import { getPosts, getBuilds, rowOf, commandProps, url } from '../lib/content';

const posts = await getPosts();
const rows = posts.map(rowOf);
const builds = (await getBuilds()).slice(0, 4);
const cmd = await commandProps();
const BOOT = [
  `${SITE.os.replace('.OS', '')}-BIOS v${SITE.version}   (c) ${new Date().getFullYear()} ${SITE.name}`,
  'CPU: curiosity @ 3.2 GHz ................ OK',
  'MEM: fresher, still filling up .......... OK',
  'Mounting /hardware /software /ai /security OK',
  `Starting ${SITE.os.toLowerCase()} ...`,
  'Welcome. Type help in the bar above any time.',
];
const procColor = { hardware: '#ff8a70', software: '#4aa8ff', security: '#b8ff3b', product: '#ff6fd8' } as const;
---
<Base home>
  <script is:inline slot="head">
    try {
      if (!sessionStorage.getItem('booted') && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('booting');
    } catch (e) {}
  </script>

  <div class="wrap" style="padding-top:6px">
    <CommandBar client:load mode="inline" {...cmd} />
  </div>

  <BootScreen client:only="preact" lines={BOOT} />

  <section class="wrap hero" aria-labelledby="hello">
    <div style="flex:999 1 460px;min-width:0">
      <h1 id="hello" class="display display-xl">{SITE.name.split(' ')[0]}<br />{SITE.name.split(' ').slice(1).join(' ')}<span class="caret" aria-hidden="true"></span></h1>
      <p class="hero__tag">{SITE.hero.tagline}</p>
      <p class="hero__intro">{SITE.hero.intro}</p>
      <ul class="layer-chips">
        {LAYER_KEYS.map((k) => (
          <li style={`background:${LAYERS[k].color}`}>
            {k === 'security' && <span class="hazard" aria-hidden="true" style="width:12px;height:12px;border-radius:2px;border:1px solid var(--deep)"></span>}
            {LAYERS[k].name}
          </li>
        ))}
      </ul>
      <div class="row" style="margin-top:26px;gap:12px">
        <a class="key key--yellow" href="#writing">READ THE LATEST ↵</a>
        <a class="key key--ghost" href={url('about/')}>WHAT I'M LEARNING</a>
      </div>
    </div>
    <ToyBench client:visible />
  </section>

  <!-- topic LEDs: click to filter the writing list -->
  <section class="wrap" aria-labelledby="topics-h" style="padding-top:24px;padding-bottom:40px">
    <h2 id="topics-h" class="sr-only">Topics</h2>
    <div class="leds" id="leds">
      {LAYER_KEYS.map((k) => (
        <div>
          <div class="led-group__head"><span style={`color:${LAYERS[k].soft}`}>{LAYERS[k].name}</span><span class="led-group__bus" aria-hidden="true"></span></div>
          <div class="led-group__row">
            {topicsOf(k).map((t) => {
              const count = posts.filter((p) => p.data.topics.includes(t)).length;
              return (
                <button type="button" class="led-btn" data-topic={t} data-name={TOPICS[t].name} aria-pressed="false" aria-label={`${TOPICS[t].name}, ${count} posts. Filter writing by this topic.`}>
                  <span class="led-btn__trace" aria-hidden="true"></span>
                  <span class="led-btn__dome" aria-hidden="true" style={`--c:${TOPICS[t].color}`}></span>
                  <span class="led-btn__legs" aria-hidden="true"><i></i><i></i></span>
                  <span class="led-btn__code">{t}</span>
                  <span class="led-btn__name">{TOPICS[t].name} · {count}</span>
                </button>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="writing" class="wrap" aria-labelledby="writing-h" style="padding-top:24px;padding-bottom:56px">
    <div class="row" style="justify-content:space-between;align-items:flex-end;gap:12px 24px;margin-bottom:18px">
      <div>
        <h2 id="writing-h" class="h2">Latest writing</h2>
        <p style="margin:10px 0 0;font-size:17px;color:var(--text)">Written while learning, so you can learn it faster.</p>
      </div>
      <div class="row" style="gap:14px">
        <LayerLegend />
        <button type="button" class="key key--ghost key--sm" id="clear-topic" hidden>GIT CHECKOUT ALL</button>
      </div>
    </div>
    <Window title="~/writing — git log --graph" pid="PID 042" class="gitlog">
      {rows.length ? (
        <ol id="home-log">
          {rows.map((r, i) => <GitRow r={r} extra={i >= 10} />)}
        </ol>
      ) : <Empty />}
      <p id="home-empty" class="gl__end" hidden style="border:none">No posts in this topic yet.</p>
      <div class="gl__end">(END) — <a href={url('writing/')}>all {rows.length} posts in git log --all</a> · <a href={url('rss.xml')}>rss</a></div>
    </Window>
  </section>

  <section id="now" class="wrap" aria-labelledby="now-h" style="padding-top:8px;padding-bottom:56px">
    <div class="split">
      <div style="flex:1 1 280px;min-width:0;max-width:360px">
        <h2 id="now-h" class="h2">Currently compiling</h2>
        <p style="margin:14px 0 0;font-size:18px;line-height:1.55;color:var(--text)">{NOW.blurb}</p>
      </div>
      <Window title="htop — now" pid={NOW.month} class="main htop">
        <div style="padding:12px 16px 16px;font-family:var(--f-mono);font-size:14px;line-height:1.7;overflow-x:auto">
          <div class="muted">Tasks: <span style="color:#fff">{NOW.procs.length}</span> running · Load avg: {NOW.load.map((x, i) => <><span style="color:#fff">{x}</span>{i < NOW.load.length - 1 ? ', ' : ''}</>)}</div>
          <table>
            <thead><tr><th scope="col">PID</th><th scope="col">CPU%</th><th scope="col">LOAD</th><th scope="col">COMMAND</th></tr></thead>
            <tbody>
              {NOW.procs.map((p, i) => {
                const k = Math.max(1, Math.round(p.cpu / 5));
                return (
                  <tr>
                    <td class="muted">{101 + i * 103}</td>
                    <td>{p.cpu}.0</td>
                    <td style="white-space:pre"><span style="color:var(--muted-2)">[</span><span style={`color:${procColor[p.layer]}`}>{'|'.repeat(k)}</span><span style="color:var(--muted-2)">{' '.repeat(20 - k)}]</span></td>
                    <td>{p.cmd}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <div style="margin-top:10px;color:var(--muted-2)">F1 help  F5 tree  F9 kill (please don't, I'm learning)</div>
        </div>
      </Window>
    </div>
  </section>

  <section id="work" class="wrap" aria-labelledby="work-h" style="padding-top:24px;padding-bottom:72px">
    <h2 id="work-h" class="h2" style="margin-bottom:8px">On the bench</h2>
    <p style="margin:0 0 32px;font-size:18px;color:rgba(255,255,255,.85)">Things I'm building to learn, and one thing I shipped for real. <a href={url('builds/')} style="color:var(--yellow)">All builds →</a></p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:40px 28px">
      {builds.map((b) => <BuildCard b={b} />)}
    </div>
  </section>

  <Subscribe slot="after" />
</Base>

<script>
  const leds = document.getElementById('leds');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#home-log [data-row]'));
  const clearBtn = document.getElementById('clear-topic') as HTMLButtonElement | null;
  const heading = document.getElementById('writing-h');
  const empty = document.getElementById('home-empty');
  let pick: string | null = null;
  const apply = () => {
    leds?.classList.toggle('has-pick', !!pick);
    leds?.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topic === pick)));
    let shown = 0;
    rows.forEach((r, i) => { const ok = pick ? (r.dataset.topics || '').split(' ').includes(pick) : i < 10; r.hidden = !ok; if (ok) shown++; });
    if (clearBtn) clearBtn.hidden = !pick;
    if (empty) empty.hidden = shown > 0;
    const b = leds?.querySelector<HTMLElement>(`[data-topic="${pick}"]`);
    if (heading) heading.textContent = pick && b ? `git log -- ${(b.dataset.name || '').toLowerCase()}` : 'Latest writing';
  };
  leds?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-topic]');
    if (!b) return;
    pick = pick === b.dataset.topic ? null : b.dataset.topic!;
    apply();
  });
  clearBtn?.addEventListener('click', () => { pick = null; apply(); });
</script>
